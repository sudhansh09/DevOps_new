{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": true,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "🏛️ Executive SLA & Availability Summary",
      "type": "row"
    },
    {
      "id": 1,
      "title": "Service Availability (Uptime SLA)",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 1 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "avg_over_time(up{job=\"egov-portal\"}[15m]) * 100",
          "legendFormat": "Uptime SLA %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 98.0 },
              { "color": "green", "value": 99.5 }
            ]
          },
          "unit": "percent",
          "decimals": 2,
          "min": 0,
          "max": 100
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "id": 2,
      "title": "Health Status (Kubernetes Liveness)",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 1 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "egov_service_health_status",
          "legendFormat": "Health Gauge",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "color": "red", "text": "DOWN / CRITICAL" }, "1": { "color": "green", "text": "HEALTHY / ONLINE" } }, "type": "value" }
          ]
        }
      },
      "options": {
        "colorMode": "background",
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }
      }
    },
    {
      "id": 3,
      "title": "P95 Response Latency",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 1 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(egov_http_request_duration_seconds_bucket[1m])) by (le)) * 1000",
          "legendFormat": "p95 Latency",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 200 },
              { "color": "red", "value": 500 }
            ]
          },
          "unit": "ms",
          "decimals": 1
        }
      },
      "options": { "colorMode": "value", "graphMode": "area" }
    },
    {
      "id": 4,
      "title": "Citizen Request Throughput",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 1 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(egov_http_requests_total[1m]))",
          "legendFormat": "Requests / Sec",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "decimals": 2, "color": { "mode": "palette-classic" } }
      },
      "options": { "colorMode": "value", "graphMode": "area" }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 },
      "id": 101,
      "title": "⏱️ Response Time & SLA Latency Analysis",
      "type": "row"
    },
    {
      "id": 5,
      "title": "Response Time Percentiles (p50, p90, p95, p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 14, "x": 0, "y": 7 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(egov_http_request_duration_seconds_bucket[1m])) by (le)) * 1000",
          "legendFormat": "p50 (Median)",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.90, sum(rate(egov_http_request_duration_seconds_bucket[1m])) by (le)) * 1000",
          "legendFormat": "p90",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(egov_http_request_duration_seconds_bucket[1m])) by (le)) * 1000",
          "legendFormat": "p95 (SLA Threshold 500ms)",
          "refId": "C"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(egov_http_request_duration_seconds_bucket[1m])) by (le)) * 1000",
          "legendFormat": "p99 (Outliers)",
          "refId": "D"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "spanNulls": false },
          "unit": "ms"
        }
      }
    },
    {
      "id": 6,
      "title": "Throughput by API Endpoint",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 10, "x": 14, "y": 7 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(egov_http_requests_total[1m])) by (endpoint)",
          "legendFormat": "{{endpoint}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "fillOpacity": 15 },
          "unit": "reqps"
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 15 },
      "id": 102,
      "title": "🛡️ Error Rates & Failure Anomaly Detection",
      "type": "row"
    },
    {
      "id": 7,
      "title": "HTTP Status Code Distribution (2xx vs 4xx vs 5xx)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(egov_http_requests_total{status_code=~\"2..\"}[1m]))",
          "legendFormat": "2xx Success",
          "refId": "A"
        },
        {
          "expr": "sum(rate(egov_http_requests_total{status_code=~\"4..\"}[1m]))",
          "legendFormat": "4xx Client Errors",
          "refId": "B"
        },
        {
          "expr": "sum(rate(egov_http_requests_total{status_code=~\"5..\"}[1m]))",
          "legendFormat": "5xx Server Failures (Chaos)",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "stacking": { "mode": "normal" } },
          "unit": "reqps"
        }
      }
    },
    {
      "id": 8,
      "title": "HTTP 5xx Failure Ratio vs SLA Alert Threshold",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "(sum(rate(egov_http_requests_total{status_code=~\"5..\"}[1m])) / sum(rate(egov_http_requests_total[1m]))) * 100",
          "legendFormat": "Actual 5xx %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "thresholdsStyle": { "mode": "line" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 10 }
            ]
          },
          "unit": "percent",
          "min": 0,
          "max": 100
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 24 },
      "id": 103,
      "title": "💻 Infrastructure & Resource Utilization",
      "type": "row"
    },
    {
      "id": 9,
      "title": "Process Resident Memory (RSS)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 25 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "process_resident_memory_bytes{job=\"egov-portal\"}",
          "legendFormat": "Memory Used",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 20 },
          "unit": "bytes"
        }
      }
    },
    {
      "id": 10,
      "title": "CPU Usage Seconds Rate",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 25 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "rate(process_cpu_seconds_total{job=\"egov-portal\"}[1m])",
          "legendFormat": "CPU Cores",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 20 },
          "unit": "short"
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 32 },
      "id": 104,
      "title": "📋 Citizen Governance Business Metrics",
      "type": "row"
    },
    {
      "id": 11,
      "title": "Active Unresolved Citizen Grievances",
      "type": "stat",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 33 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "egov_active_grievances_total",
          "legendFormat": "Active Tickets",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short"
        }
      },
      "options": { "colorMode": "value", "graphMode": "area" }
    },
    {
      "id": 12,
      "title": "Applications Processed by Service Category",
      "type": "bargauge",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 33 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "egov_applications_processed_total",
          "legendFormat": "{{service_code}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" } }
      },
      "options": { "orientation": "horizontal", "displayMode": "gradient" }
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["devops", "egov", "prometheus", "kubernetes"],
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": { "refresh_intervals": ["5s", "10s", "30s", "1m"] },
  "timezone": "browser",
  "title": "E-Governance Portal Operational Dashboard",
  "uid": "egov-ops-portal-v1",
  "version": 1
}
